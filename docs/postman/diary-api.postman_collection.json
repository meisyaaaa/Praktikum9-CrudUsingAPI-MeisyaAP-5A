{
  "info": {
    "name": "Diary API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "id", "value": "1" }
  ],
  "item": [
    {
      "name": "1. GET semua diary",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/diaries", "host": ["{{baseUrl}}"], "path": ["api", "diaries"] }
      }
    },
    {
      "name": "2. GET search (?search=kampus)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/diaries?search=kampus",
          "host": ["{{baseUrl}}"],
          "path": ["api", "diaries"],
          "query": [{ "key": "search", "value": "kampus" }]
        }
      }
    },
    {
      "name": "3. GET detail diary",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/diaries/{{id}}", "host": ["{{baseUrl}}"], "path": ["api", "diaries", "{{id}}"] }
      }
    },
    {
      "name": "4. POST tambah diary (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Catatan Postman\",\n  \"diary_date\": \"2026-11-24\",\n  \"body\": \"Diary ini dibuat dari Postman\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/diaries", "host": ["{{baseUrl}}"], "path": ["api", "diaries"] }
      }
    },
    {
      "name": "5. POST judul terlalu pendek (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"ab\",\n  \"diary_date\": \"2026-11-24\",\n  \"body\": \"Judul hanya 2 karakter\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/diaries", "host": ["{{baseUrl}}"], "path": ["api", "diaries"] }
      }
    },
    {
      "name": "6. PUT favorite (liked = 1)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"liked\": 1\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/diaries/{{id}}", "host": ["{{baseUrl}}"], "path": ["api", "diaries", "{{id}}"] }
      }
    },
    {
      "name": "7. PUT edit diary",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Catatan Postman (diedit)\",\n  \"body\": \"Isi diary sudah diperbarui\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/diaries/{{id}}", "host": ["{{baseUrl}}"], "path": ["api", "diaries", "{{id}}"] }
      }
    },
    {
      "name": "8. DELETE diary",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/diaries/{{id}}", "host": ["{{baseUrl}}"], "path": ["api", "diaries", "{{id}}"] }
      }
    }
  ]
}